# Supabase
# Publishable values. The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Used for privileged writes such as event ingestion.
SUPABASE_SERVICE_ROLE_KEY=

# K-Startup public data API — server only. Never commit a real key or prefix it with NEXT_PUBLIC_.
# Used by getAnnouncementInformation01 on apis.data.go.kr.
KSTARTUP_API_KEY=

# OpenRouter — server only. Never commit a real key or prefix it with NEXT_PUBLIC_.
# Jev is called at POST https://openrouter.ai/api/alpha/decisions.
OPENROUTER_API_KEY=

# Jev model id for the Decisions API. Not the chat completions model route.
JEV_MODEL=typesafe/jev-1.13

# Application
# demo: in-memory catalog, no Supabase credentials required.
# supabase: persist profiles, events, evaluations, and saved events.
APP_MODE=demo
